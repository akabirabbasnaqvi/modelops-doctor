# Application
APP_NAME=ModelOps Doctor API
APP_DESCRIPTION=A full-stack MLOps platform for model monitoring, drift detection, health scoring, and diagnosis reports.
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=modelops_user
# Local demo credentials match `docker compose up -d db redis`.
POSTGRES_PASSWORD=modelops_password
POSTGRES_DB=modelops_doctor
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
CELERY_TASK_ALWAYS_EAGER=false

# Local storage
STORAGE_PATH=./storage

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
